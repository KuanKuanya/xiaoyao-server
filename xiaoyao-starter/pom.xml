<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiaoyao</groupId>
        <artifactId>xiaoyao-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>xiaoyao-starter</artifactId>
    <packaging>jar</packaging>

    <name>xiaoyao-starter</name>
    <description>启动模块 - 游戏服务器启动入口</description>

    <dependencies>
        <!-- Spring Boot JDBC（DataSource 自动配置） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 逻辑服模块（传递引入所有业务依赖：ionet, mybatis-flex, spring等） -->
        <dependency>
            <groupId>com.xiaoyao</groupId>
            <artifactId>xiaoyao-logic</artifactId>
        </dependency>

        <!-- 对外服模块 -->
        <dependency>
            <groupId>com.xiaoyao</groupId>
            <artifactId>xiaoyao-external</artifactId>
        </dependency>

        <!-- 日志实现（运行时需要） -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打包成可执行 JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.xiaoyao.starter.XiaoyaoApplication</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- 复制依赖到 lib 目录 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
